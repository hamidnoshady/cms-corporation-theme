{
  "name": "cms-corporation-theme",
  "version": "0.2.0",
  "private": true,
  "description": "Apex \u2014 Vercel-inspired corporate/SaaS marketing theme for Eshobe CMS (Biza Miz first tenant).",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "test:visual": "playwright test --grep visual",
    "smoke": "node scripts/smoke.mjs",
    "audit:runtime": "pnpm audit --prod --audit-level=high",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.ts\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@eshobe/site-runtime": "file:vendor/site-runtime",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "type": "module"
}
