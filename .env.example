# Eshobe injects these at deployment. Never put values in source or browser code.
# ESHOBE_CMS_URL is the reachable CMS origin (Eshobe copies its DEPLOY_CMS_URL here).
# HTTPS, or a single-label internal service name such as http://eshobe-cms-web:3000.
# A multi-label internal name or internal IP over HTTP needs APEX_CMS_HTTP_ORIGINS.
# ESHOBE_CMS_URL=https://cms.example.com
# ESHOBE_API_KEY=
# ESHOBE_SITE_ID=
# ESHOBE_SITE_DOMAIN=www.example.com
# ESHOBE_DEFAULT_LOCALE=fa
# ESHOBE_LOCALES=fa,en
# ESHOBE_SITE_TYPE=business
# ESHOBE_CURRENCY=IRR
# ESHOBE_PUBLIC_ORIGIN=https://www.example.com
# ESHOBE_REVALIDATE_SECRET=
# ESHOBE_CONTRACT_VERSION=1

# CMS origin policy for server-only CMS reads (never sent to the browser).
# Comma-separated exact host[:port] entries that may be used over plain HTTP when
# they are not a single-label Docker service name. No wildcards; public HTTP hosts
# stay rejected. Example: APEX_CMS_HTTP_ORIGINS=cms.internal.example,10.0.0.12:3000
# APEX_CMS_HTTP_ORIGINS=
# Bearer token for GET /api/ready. Optional: ESHOBE_REVALIDATE_SECRET is accepted
# too, so CMS-backed deployments are ready to probe without extra configuration.
# APEX_READY_TOKEN=

# Tenant secrets/config: set through Eshobe Theme Settings, not chat.
# BIZAMIZ_LEAD_WEBHOOK_URL=https://<approved-bizamiz-origin>/api/website/leads
# BIZAMIZ_LEAD_TOKEN=
# LEAD_FORM_SECRET=
# ESHOBE_PREVIEW_SECRET= # same value as CMS PREVIEW_SECRET; editor token also required
# BIZAMIZ_CATALOGUE_URL= # approved published feed, docs/INTEGRATIONS.md
# BIZAMIZ_CATALOGUE_TOKEN=
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_EVENTS_URL=
# BIZAMIZ_CONVERSION_SECRET=
# APEX_TRUSTED_IP_HEADER= # only when the trusted edge overwrites it
# APEX_NOINDEX=true

# Local sample mode. Production without CMS configuration fails closed unless
# APEX_DEMO_MODE is explicitly enabled. Do not set it on a customer deployment.
APEX_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local integration tests ONLY (loopback HTTP upstreams such as the CRM fixture and
# a loopback CMS during tests). Never enable it in a live deployment: use a
# service name or APEX_CMS_HTTP_ORIGINS for the CMS instead.
# APEX_ALLOW_LOCAL_UPSTREAM=true
# APEX_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
